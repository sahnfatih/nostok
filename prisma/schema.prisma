// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AuthToken {
  id              String   @id
  merchantId      String
  authorizedAppId String?  @unique
  salesChannelId  String?
  type            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deleted         Boolean  @default(false)

  accessToken     String
  tokenType       String
  expiresIn       Int
  expireDate      DateTime
  refreshToken    String
  scope           String?
}

model InventorySnapshot {
  id                  String   @id @default(uuid())
  merchantId          String
  date                String
  totalVariants       Int
  totalStockUnits     Int
  totalInventoryValue Float
  lowStockCount       Int
  outOfStockCount     Int
  deadStockCount      Int
  deadStockValue      Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([merchantId, date])
}

model ClearanceRule {
  id              String   @id @default(uuid())
  merchantId      String
  name            String
  stockThreshold  Int
  discountPercent Float
  isActive        Boolean  @default(true)
  autoApply       Boolean  @default(false)
  categoryFilter  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaigns       ClearanceCampaign[]
}

model ClearanceCampaign {
  id              String   @id @default(uuid())
  merchantId      String
  campaignId      String   @unique
  ruleId          String?
  title           String
  discountPercent Float
  variantIds      String
  variants        String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rule            ClearanceRule? @relation(fields: [ruleId], references: [id])
}
